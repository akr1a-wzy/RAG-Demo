APP_ENV=development
LOG_LEVEL=INFO
TENCENT_CONNECT_TIMEOUT_SECONDS=5
TENCENT_READ_TIMEOUT_SECONDS=10
TENCENT_MAX_ATTEMPTS=3
CHROMA_DIR=data/chroma
CHECKPOINT_DB=data/checkpoints.sqlite
CACHE_DIR=data/cache
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Keep the real key in local .env only; never paste it into logs or reports.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_READ_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_TOKENS=1800
QA_SESSION_DB=data/qa_sessions.sqlite

